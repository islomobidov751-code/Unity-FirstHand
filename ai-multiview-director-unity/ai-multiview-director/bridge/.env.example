# Copy this file to ".env" (same folder) and edit. Every setting is optional.

# Port for the dashboard, viewer page, mock game and WebSocket bridge
PORT=8080

# Translation beyond the built-in languages (Korean, Japanese, Spanish, Chinese, English).
# Get a key at https://console.anthropic.com  — usage is billed to that account.
# Leave empty to run offline with the built-in languages only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
